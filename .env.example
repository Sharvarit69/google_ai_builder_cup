# Copy this file to .env and fill in the values. Never commit .env.
GEMINI_API_KEY=
GEN_PASSCODE=
GCS_BUCKET=
TEXT_MODEL=
VIDEO_UNDERSTANDING_MODEL=
VEO_MODEL=
# GEN_PASSCODE must be set or video generation stays switched off.
VEO_BUDGET_SECONDS=200
SHOT_SECONDS=8
MAX_REPAIRS=2
MAX_GEN_RETRIES=2
# Frames per second the critic looks at. Empty or 0 = Gemini's default (about 1).
# Higher catches brief changes (an object popping in) but costs more per check.
CRITIC_FPS=
